{
  "default-configuration": "Debug",
  "configurations": ["Debug", "Release"],
  "localizations": {"development": "en", "supported": ["en"]},
  "packages": [{"kind": "local", "path": "../../../AsyncGL", "traits": ["OpenGL"]}],
  "files": [
    {"kind": "folder", "path": "App", "target-membership": ["NativeMac", "NativeUIKit"]},
    {"kind": "group", "name": "Products", "children": [
      {"path": "<PRODUCTS>/NativeMac.app", "type": "wrapper.application", "index": false},
      {"path": "<PRODUCTS>/NativeUIKit.app", "type": "wrapper.application", "index": false}
    ]}
  ],
  "targets": [
    {
      "name": "NativeMac",
      "id": "A10000000000000000000001",
      "product": "Products/NativeMac.app",
      "product-type": "application",
      "build-phases": ["compile-sources", "frameworks", "resources"],
      "package-product-members": [{"package": "AsyncGL", "product-name": "AsyncGL", "build-phase": {"build-phase": "frameworks"}}],
      "build-settings": {
        "SDKROOT": "macosx",
        "SUPPORTED_PLATFORMS": "macosx",
        "PRODUCT_BUNDLE_IDENTIFIER": "space.celestia.AsyncGLRuntime.NativeMac",
        "INFOPLIST_KEY_LSUIElement": "YES"
      }
    },
    {
      "name": "NativeUIKit",
      "id": "A10000000000000000000002",
      "product": "Products/NativeUIKit.app",
      "product-type": "application",
      "build-phases": ["compile-sources", "frameworks", "resources"],
      "package-product-members": [{"package": "AsyncGL", "product-name": "AsyncGL", "build-phase": {"build-phase": "frameworks"}}],
      "build-settings": {
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "PRODUCT_BUNDLE_IDENTIFIER": "space.celestia.AsyncGLRuntime.NativeUIKit",
        "INFOPLIST_FILE": "UIKitInfo.plist"
      }
    }
  ],
  "build-settings": {
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "GCC_C_LANGUAGE_STANDARD": "c11",
    "GCC_PREPROCESSOR_DEFINITIONS": ["$(inherited)", "HOST_ANGLE=0"],
    "HEADER_SEARCH_PATHS": ["$(inherited)", "$(SRCROOT)/../../AsyncGL"],
    "GENERATE_INFOPLIST_FILE": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "MACOSX_DEPLOYMENT_TARGET": "13.0",
    "IPHONEOS_DEPLOYMENT_TARGET": "16.0",
    "MARKETING_VERSION": "1.0",
    "CURRENT_PROJECT_VERSION": "1",
    "CODE_SIGN_IDENTITY": "-",
    "CODE_SIGNING_REQUIRED": "NO",
    "ENABLE_HARDENED_RUNTIME": "NO",
    "LD_RUNPATH_SEARCH_PATHS": ["$(inherited)", "@executable_path/Frameworks", "@executable_path/../Frameworks"],
    "OTHER_LDFLAGS": ["$(inherited)", "-ObjC"]
  }
}
